    subgraph KB["المعرفة المحفوظة بين الفحوصات — Knowledge kept between scans"]
        LEARNED[("<b>learned/rules.yaml</b><br/><b>learned/overrides.yaml</b><br/>القواعد والاستثناءات المتعلَّمة<br/>التي صادقتَ عليها، ملفات YAML")]
