<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The old payment pages are still served over HTTP; testers use a proxy CA. -->
    <base-config
        cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates
                src="system" />
            <certificates
                src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
