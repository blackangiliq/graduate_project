    end

    subgraph IMP["كيف تُستورد قاعدة مفتوحة المصدر  ·  tools/import_rules.py"]
        direction TB
        I1["<b>1. التحويل — Convert</b><br/>تعابير ‎.NET و Go إلى صيغة re في بايثون<br/>أسماء اللغات، الخطورة، ورقم CWE من وسوم القاعدة"]
        I2["<b>2. الفحوص الآلية — Automatic checks</b><br/>يُترجَم التعبير · ينتهي على أسطر الإجهاد داخل sandbox<br/>ينجح في أمثلته: must-match و must-not-match<br/>صامت على الكود المعروف أنه آمن"]
        I3["<b>3. القياس على كود حقيقي</b><br/>2.4 مليون سطر من 21 مشروعاً مفتوح المصدر معروفاً<br/>كم سطراً تعلّمه القاعدة؟"]
        I4{"قاعدة مراجعة، أو مزعجة،<br/>أو حُكم عليها يدوياً بأنها غير مفيدة؟"}
        I5["<b>تأتي مفعّلة</b><br/>DevSkim 49 · Gitleaks 204"]
        I6["<b>تأتي معطّلة مع ذكر السبب</b><br/>DevSkim 46 · Gitleaks 1<br/>تستطيع تفعيلها"]
